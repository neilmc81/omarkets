#!/usr/bin/env bash
# Stop the Omarkets backend and frontend started by omarkets-start.
#
# Processes are resolved from the actual listeners on the Omarkets loopback
# ports (never by command-line pattern), so this cannot match unrelated shells
# or the caller. Only processes owned by the current user are stopped.
#
# Usage: omarkets-stop
set -euo pipefail

ports=(8765 5173 4173)
stopped=0

pid_for_port() {
    # Print the PID owning the TCP listener on 127.0.0.1:$1, if any.
    ss -ltnpH "sport = :$1" 2>/dev/null \
        | grep -oP 'pid=\K[0-9]+' \
        | sort -u
}

for port in "${ports[@]}"; do
    while read -r pid; do
        [[ -z $pid || $pid == "$$" ]] && continue
        owner=$(stat -c '%u' "/proc/$pid" 2>/dev/null || printf '')
        if [[ $owner == "$(id -u)" ]]; then
            kill "$pid" 2>/dev/null && stopped=1
        fi
    done < <(pid_for_port "$port")
done

if [[ $stopped == 1 ]]; then
    # Give uvicorn/vite a moment to release the ports.
    for _ in 1 2 3 4 5 6; do
        if ! ss -ltnH 2>/dev/null | grep -qE ':(8765|5173|4173)\b'; then
            break
        fi
        sleep 0.5
    done
    printf 'Omarkets servers stopped.\n'
else
    printf 'No Omarkets servers were running.\n'
fi
