#!/usr/bin/env bash
# Open (or focus) the Omarkets workstation.
#
# Usage: omarkets-launch [port] [--section <name>]
#   port      frontend port (default 8765, served by the backend)
#   --section deep-link into a Details page: overview|macro|calendar|news
#             (no section opens the Today screen)
#
# Behaviour:
#   1. If a Omarkets window already exists, focus it instead of opening a
#      duplicate (never spawns a second window for the same app).
#   2. Otherwise open the URL as a web app using the Omarchy/Chromium launcher.
#   3. If the backend port is not serving, start nothing implicitly and report a
#      useful message — use `omarkets-start` or the user service.
set -euo pipefail

help() {
    printf '%s\n' \
        'Usage: omarkets-launch [port] [--section <name>]' \
        'Opens or focuses the Omarkets workstation.' \
        'Sections: overview macro calendar news (none opens Today)'
}

port=8765
section=""
while [[ $# -gt 0 ]]; do
    case $1 in
        --help|-h) help; exit 0 ;;
        --section)
            [[ $# -ge 2 ]] || { printf 'omarkets-launch: --section needs a value\n' >&2; exit 2; }
            section=$2; shift 2 ;;
        ''|*[!0-9]*) printf 'omarkets-launch: port must be numeric\n' >&2; exit 2 ;;
        *) port=$1; shift ;;
    esac
done
if (( port < 1 || port > 65535 )); then
    printf 'omarkets-launch: port out of range\n' >&2
    exit 2
fi

url="http://127.0.0.1:${port}/"
if [[ -n $section ]]; then
    url="${url}?section=${section}"
fi

# Focus an existing Omarkets window, else open it. Prefer Omarchy's own
# launch-or-focus helper (which knows the current Hyprland dispatch syntax);
# fall back to a direct focus using that syntax, then to a plain launcher.
# A window already open: focus it and never spawn a duplicate. A section
# deep-link still focuses the existing window rather than opening a second one.
if command -v hyprctl >/dev/null 2>&1; then
    address=$(hyprctl clients -j 2>/dev/null | python3 -c '
import json,sys
try:
    clients = json.load(sys.stdin)
except Exception:
    raise SystemExit(0)
for c in clients:
    if c.get("title") == "Omarkets":
        print(c.get("address","")); break
' 2>/dev/null || true)
    if [[ -n ${address:-} ]]; then
        # Current Hyprland syntax first, then the legacy form.
        hyprctl dispatch "hl.dsp.focus({ window = \"address:${address}\" })" >/dev/null 2>&1 && exit 0
        hyprctl dispatch focuswindow "address:${address}" >/dev/null 2>&1 && exit 0
    fi
fi

if command -v omarchy-launch-webapp >/dev/null 2>&1; then
    exec omarchy-launch-webapp "$url"
fi
if command -v xdg-open >/dev/null 2>&1; then
    exec xdg-open "$url"
fi
printf 'omarkets-launch: no supported webapp launcher or xdg-open found\n' >&2
exit 1
