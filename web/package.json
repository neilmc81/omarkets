{
  "name": "omarkets-web",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "OMARKETS_LIVE_CONTRACT=1 vitest run tests/web/api/localContract.check.ts",
    "typecheck": "tsc -b --noEmit",
    "lint": "node --input-type=module -e \"import { spawnSync } from 'node:child_process'; process.exit(spawnSync(process.execPath, ['web/node_modules/eslint/bin/eslint.js', '--no-config-lookup', '--config', 'web/eslint.config.js', 'web/src', 'web/vite.config.ts', 'tests/web'], { cwd: '..', stdio: 'inherit' }).status ?? 1)\""
  },
  "dependencies": {
    "lightweight-charts": "^5.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^26.0.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^25.0.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.4.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
