# Omarkets settings. Copy to `.env` and fill in. Never commit `.env`.
# Every value except OPENROUTER_API_KEY is optional; remove the leading "# "
# to change a default. Old MARKETOS_* names still work; OMARKETS_* wins.

# --- Required ---------------------------------------------------------------
# OpenRouter key for the AI desk notes (https://openrouter.ai/keys).
OPENROUTER_API_KEY=

# --- Optional data keys (free) ----------------------------------------------
# Without a key, the data from that source is not shown.
# OMARKETS_FRED_API_KEY=
# OMARKETS_BLS_API_KEY=
# OMARKETS_CENSUS_API_KEY=
# OMARKETS_BEA_API_KEY=
# OMARKETS_EIA_API_KEY=

# --- AI spending caps (USD) -------------------------------------------------
# 0 turns a cap off. When all caps are 0, request-count limits are off too.
# OMARKETS_AI_DAILY_BUDGET_USD=0.20
# OMARKETS_AI_MONTHLY_BUDGET_USD=5
# OMARKETS_AI_WEEKLY_BUDGET_USD=0
# Where budget days, weeks and months start (IANA time zone). Auto-detected
# from the system (TZ, then /etc/localtime); set this to override it.
# OMARKETS_AI_BUDGET_TIMEZONE=Europe/London
# Optional request-count limits for OpenRouter (no limit unless set).
# OMARKETS_AI_OPENROUTER_DAILY_REQUEST_LIMIT=40
# OMARKETS_AI_OPENROUTER_BACKGROUND_REQUEST_LIMIT=20

# --- Desk notes -------------------------------------------------------------
# OMARKETS_DESK_ENABLED=true
# Desktop notifications for new notes, and the 07:00 ET daily plan.
# OMARKETS_DESK_NOTIFY=true
# OMARKETS_DESK_DAILY_PLAN=true
# Your time zone; the daily plan shows times in it. Auto-detected from the
# system (TZ, then /etc/localtime); set this to override it. Market hours
# always stay in exchange time (New York).
# OMARKETS_DESK_LOCAL_TIMEZONE=Europe/London
# NQ move (percent, over about an hour) that gets its own note, used only until
# there is enough history to scale it to the typical daily range.
# OMARKETS_DESK_MOVE_THRESHOLD_PCT=0.8
# OpenRouter model per note kind (JSON). The defaults use a strong model for
# the pre-market note and weekly review and a cheap model for the rest.
# OMARKETS_DESK_MODELS={"move": "provider/model"}
# One model for every kind (used when OMARKETS_DESK_MODELS has no entry).
# OMARKETS_DESK_MODEL=provider/model
# Model used once more when the first one fails. Empty turns the retry off.
# OMARKETS_DESK_FALLBACK_MODEL=provider/model
# Upper-bound USD per million (input, output) tokens per model, used to
# reserve budget before each call (JSON).
# OMARKETS_DESK_MODEL_RATES={"provider/model": [3, 15]}
# Rates for models not in the list above.
# OMARKETS_DESK_INPUT_RATE=3
# OMARKETS_DESK_OUTPUT_RATE=15
# Prompt version new notes are written with: desk:v9 (default; shared rules
# plus a profile per instrument: NQ, ES, YM, GOLD and WTI) or desk:v8 (NQ's
# older text, NQ only).
# OMARKETS_DESK_PROMPT_VERSION=desk:v9
# Instruments that get their own notes (default NQ, ES, YM, GOLD and WTI). NQ
# (always on) gets pre-market, move and ask notes; ES, YM, GOLD and WTI move
# and ask only. Each needs a prompt at the version above, or the service
# refuses to start and says what to change: ES, YM, GOLD and WTI need desk:v9.
# For NQ only on desk:v8, set both lines. Check with `omarketsctl config`.
# OMARKETS_DESK_INSTRUMENTS=["NQ", "ES", "YM", "GOLD", "WTI"]

# --- Market data ------------------------------------------------------------
# live uses real feeds; demo uses synthetic data in its own database.
# OMARKETS_MARKET_DATA_MODE=live
# OMARKETS_MARKET_POLL_SECONDS=5
# Days before expiry to roll to the next futures contract.
# OMARKETS_FUTURES_ROLL_DAYS=8

# --- Economic calendar ------------------------------------------------------
# live | demo | disabled
# OMARKETS_ECONOMIC_MODE=live
# OMARKETS_ECONOMIC_POLL_SECONDS=21600
# Per-provider poll intervals in seconds (JSON, minimum 30).
# OMARKETS_ECONOMIC_POLL_OVERRIDES={"bls": 86400, "fred": 21600}

# --- News -------------------------------------------------------------------
# OMARKETS_NEWS_ENABLED=true
# OMARKETS_NEWS_POLL_SECONDS=300
# JSON lists of source names. An empty enabled list means all sources.
# OMARKETS_NEWS_ENABLED_SOURCES=[]
# OMARKETS_NEWS_DISABLED_SOURCES=[]

# --- Local server and files -------------------------------------------------
# The API always binds to 127.0.0.1.
# OMARKETS_API_PORT=8765
# OMARKETS_LOG_LEVEL=INFO
# OMARKETS_DATA_DIR=./data
# Built web app served by the core (default web/dist in this checkout).
# OMARKETS_FRONTEND_DIST=/path/to/omarkets/web/dist
# Omarchy theme the UI takes its colours from (default: the active theme).
# OMARKETS_OMARCHY_THEME_DIR=/path/to/theme
